    "jarelkiri": "node agent/jarelkiri.mjs",
    "jarelkiri:seis": "node agent/jarelkiri.mjs --seis",
    "jarelkiri:kuiv": "node agent/jarelkiri.mjs --kuiv",
    "agent:policy": "node agent/probe-codex-policy.mjs",
