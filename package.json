    "registry:financials": "node agent/registry-financials.mjs",
    "registry:backfill": "node agent/registry-backfill.mjs",
    "registry:website-fallback": "node agent/registry-website-fallback.mjs",
    "registry:email:gate": "node test/gate-registry-email-fallback.mjs",
    "registry:gate": "node test/gate-registry.mjs",
    "registry:update": "npm run registry:sync && npm run registry:enrich && npm run registry:financials && npm run registry:backfill -- --kirjuta",
