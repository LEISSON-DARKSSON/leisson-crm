    "hanked:ui:gate": "node test/gate-hanked-ui.mjs",
    "hanked:vaade:gate": "node test/gate-hanked-vaade.mjs",
    "pariteet:gate": "node test/gate-pariteet.mjs",
    "pariteet:uuenda": "node tools/pariteet-uuenda.mjs",
    "pariteet:python": "node tools/pariteet-python.mjs",
    "agent:dryrun": "node agent/dryrun.mjs",
    "agent:gate": "node test/gate-agent.mjs",
    "agent:status": "node agent/worker.mjs --status",
    "agent:triage": "node agent/worker.mjs --enqueue=triage --drain",
    "install:win": "powershell -ExecutionPolicy Bypass -File win/install-autostart.ps1",
