    "campaign:uninstall:win": "powershell -ExecutionPolicy Bypass -File win/install-kampaania.ps1 -Eemalda",
    "campaign:ui:gate": "node test/gate-campaign-ui.mjs",
    "saatja:seis": "node agent/saatja.mjs --seis",
